#!/bin/sh
set -e

case "$1" in
    configure)
        # Check if upstream alsa-ucm-conf provides p241
        if dpkg -L alsa-ucm-conf 2>/dev/null | grep -q '^/usr/share/alsa/ucm2/Amlogic/p241'; then
            # Upstream provides p241, remove our symlink if present
            if [ -L /usr/share/alsa/ucm2/Amlogic/p241 ]; then
                rm -f /usr/share/alsa/ucm2/Amlogic/p241
            fi
        else
            # Upstream doesn't provide p241, create our symlink
            ln -sfn /usr/share/libretech-alsa-ucm-conf/ucm2/Amlogic/p241 /usr/share/alsa/ucm2/Amlogic/p241
        fi
        ;;
esac

#DEBHELPER#

exit 0
